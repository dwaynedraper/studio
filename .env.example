# ─────────────────────────────────────────────────────────────────────
# Sharp Sighted Studio — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local`. Dean populates these from his end.
# ─────────────────────────────────────────────────────────────────────

# ─── Sanity CMS ────────────────────────────────────────────────────────
# Project ID and dataset come from the Sanity dashboard. The API token is
# server-only and used for write/preview operations. The public dataset
# (typically `production`) is also exposed to the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
# Server-side write/preview token. Keep secret.
SANITY_API_TOKEN=
# Mirror of the project id/dataset for the in-app Studio mount + image-url
# builder. These are public.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with Sanity's webhook so we can verify revalidation requests.
SANITY_WEBHOOK_SECRET=

# ─── Auth.js v5 (Discord OAuth) ────────────────────────────────────────
# Generate AUTH_SECRET with: `openssl rand -base64 32`
AUTH_SECRET=
# Discord OAuth credentials — create an application at
# https://discord.com/developers/applications, add OAuth2 redirect:
#   http://localhost:3000/api/auth/callback/discord  (dev)
#   https://sharpsighted.studio/api/auth/callback/discord  (prod)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Standing Discord invite link surfaced on the Join page and Discuss CTAs.
DISCORD_INVITE_URL=
# Dean's Discord user ID. The first sign-in matching this snowflake is
# auto-elevated to super-admin in the users table. Subsequent sign-ins
# never downgrade. Right-click your Discord profile → Copy User ID
# (Developer Mode must be on).
SUPER_ADMIN_DISCORD_ID=

# ─── Postgres (Vercel Postgres or Neon) ────────────────────────────────
# Connection string for the reaction + user + social-feed cache tables.
DATABASE_URL=

# ─── Plausible analytics ───────────────────────────────────────────────
# The domain registered in Plausible. Used by the layout script. The
# layout also sends events to the rollup property `sharp-sighted-network`.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sharpsighted.studio
# Full URL of the Plausible script (allows self-hosted or proxied instances).
# e.g., https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# ─── Social-feed polling ───────────────────────────────────────────────
# All used by the /api/cron/feed-poll Vercel Cron Job that refreshes
# social_feed_items every 30 minutes.
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
# Secret used to authorize Vercel Cron POSTs to /api/cron/*.
CRON_SECRET=

# ─── Misc ──────────────────────────────────────────────────────────────
# Optional override; defaults to https://sharpsighted.studio.
NEXT_PUBLIC_SITE_URL=https://sharpsighted.studio
